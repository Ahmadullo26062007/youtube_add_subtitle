{
  "manifest_version": 3,
  "name": "YouTube Uzbek Translator",
  "version": "1.0.0",
  "description": "YouTube subtitlelarni avtomatik o'zbek tiliga tarjima qiladi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:5055/*",
    "http://127.0.0.1:5055/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Uzbek Translator"
  }
}
